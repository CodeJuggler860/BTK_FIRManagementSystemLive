@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Bahria Town Karachi Police</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons only (no Bootstrap layout needed here) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Shared design tokens & base styles -->
    <link rel="stylesheet" href="~/Content/site.css" asp-append-version="true" />
    <!-- Login-specific layout -->
    <link rel="stylesheet" href="~/Content/login.css" asp-append-version="true" />
</head>
<body>

    <div class="login-page">

        <!-- ════════════════════════════════════
             LEFT — Brand / decorative panel
             ════════════════════════════════════ -->
        <div class="login-left">
            <div class="login-left-ring"></div>

            <!-- Brand -->
            <div class="login-brand">
                <div class="shield-wrap">
                    <i class="bi bi-shield-fill-check"></i>
                </div>
                <h1>Bahria Town Karachi</h1>
                <p>Security Department</p>
            </div>

            <!-- Hero copy -->
            <div class="login-hero">
                <div class="login-hero-icon">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <h2>FIR Management&nbsp;System</h2>
                <p>
                    A centralised platform for Bahria Town Karachi Security Department
                    to add, track, and resolve First Information Reports (FIRs)
                    with speed and precision.
                </p>
            </div>

            <!-- Stat pills -->
          
        </div>

        <!-- ════════════════════════════════════
             RIGHT — Login form
             ════════════════════════════════════ -->
        <div class="login-right">
            <div class="login-card">

                <!-- Header -->
                <div class="login-card-header">
                    <div class="eyebrow"><i class="bi bi-lock me-1"></i>Secure Access</div>
                    <h2>Welcome back,<br>Security Team</h2>
                    <p>Sign in to your account to access the FIR Management dashboard.</p>
                </div>

                <!-- Error alert (shown on failed login) -->
                <div class="login-error hidden" id="loginError">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span id="loginErrorMsg">Invalid credentials. Please try again.</span>
                </div>

                <!-- Form -->
                <form id="loginForm" asp-controller="Account" asp-action="Login" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Username / Badge No -->
                    <div class="login-form-group">
                        <label for="username">Username</label>
                        <div class="input-wrap">
                            <i class="bi bi-person input-icon"></i>
                            <input type="text"
                                   id="username"
                                   name="Username"
                                   placeholder="e.g. BTK-2026-001"
                                   autocomplete="username"
                                   required />
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="login-form-group">
                        <label for="password">Password</label>
                        <div class="input-wrap">
                            <i class="bi bi-lock input-icon"></i>
                            <input type="password"
                                   id="password"
                                   name="Password"
                                   class="has-toggle"
                                   placeholder="Enter your password"
                                   autocomplete="current-password"
                                   required />
                            <button type="button" class="toggle-pw" id="togglePw" tabindex="-1"
                                    aria-label="Show/hide password">
                                <i class="bi bi-eye" id="togglePwIcon"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Remember me + Forgot -->
                    <div class="login-meta">
                        <label class="remember-wrap">
                            <input type="checkbox" name="RememberMe" id="rememberMe" />
                            <span>Remember me</span>
                        </label>
                        @*<a href="#" class="forgot-link">Forgot password?</a>*@
                    </div>

                    <!-- Submit -->
                    <button type="submit" class="btn-login" id="loginBtn">
                        <span class="btn-label">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </span>
                        <span class="spinner"></span>
                    </button>

                </form>

                <!-- Divider -->
                <div class="login-divider">
                    <span>Need help?</span>
                </div>

                <!-- Footer note -->
                <div class="login-footer-note">
                    <i class="bi bi-shield-lock"></i>
                    <span>
                        Access is restricted to authorised Bahria Town Karachi Police personnel only.
                        Unauthorised access attempts are logged and may result in disciplinary action.
                    </span>
                </div>

            </div>
        </div>

    </div>

    <script>
(function () {

    /* ── Toggle password visibility ── */
    const pwInput  = document.getElementById('password');
    const pwIcon   = document.getElementById('togglePwIcon');
    document.getElementById('togglePw').addEventListener('click', function () {
        const isHidden = pwInput.type === 'password';
        pwInput.type   = isHidden ? 'text' : 'password';
        pwIcon.className = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
    });

    /* ── Client-side validation + loading state ── */
    document.getElementById('loginForm').addEventListener('submit', function (e) {
        const username = document.getElementById('username');
        const password = document.getElementById('password');
        const errorEl  = document.getElementById('loginError');
        let valid = true;

        // Clear previous state
        errorEl.classList.add('hidden');
        username.classList.remove('is-invalid');
        password.classList.remove('is-invalid');

        if (!username.value.trim()) {
            username.classList.add('is-invalid');
            valid = false;
        }
        if (!password.value) {
            password.classList.add('is-invalid');
            valid = false;
        }

        if (!valid) {
            e.preventDefault();
            document.getElementById('loginErrorMsg').textContent =
                'Please enter your badge number and password.';
            errorEl.classList.remove('hidden');
            return;
        }

        /* Show loading spinner while form submits */
        const btn = document.getElementById('loginBtn');
        btn.classList.add('loading');
        btn.disabled = true;
    });

    /* ── Show server-side error if present (via ViewBag) ── */
    @if (ViewBag.Error != null)
    {
        <text>
        (function() {
            const err = document.getElementById('loginError');
            document.getElementById('loginErrorMsg').textContent = '@Html.Raw(ViewBag.Error)';
            err.classList.remove('hidden');
        })();
        </text>
    }

})();
    </script>

</body>
</html>
