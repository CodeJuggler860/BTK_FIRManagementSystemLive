    <!-- Scripts -->
    <!--<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.0/dist/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <script>
        // ==================== FIR Management – Hybrid: Traditional Forms + AJAX DataTable ====================
        var ioOptions = [];        // [{ id: 8, name: "Insp. Abdul Qadir" }, ...]
        var statusOptions = [];    // [{ value: "REGISTERED", label: "Registered" }, ...]

        // 1. Load dropdowns from database
        function loadDropdowns() {
            // Investigating Officers
            $.getJSON('/FIR/GetIOList', function (data) {
                ioOptions = data;
                var $ioSelect = $('#newIO');
                $ioSelect.empty().append('<option value="" disabled selected>Select officer</option>');
                $.each(data, function (i, io) {
                    $ioSelect.append($('<option>', { value: io.id, text: io.name }));
                });

                var $filterIO = $('#filterIO');
                $filterIO.empty().append('<option value="">All Officers</option>');
                $.each(data, function (i, io) {
                    $filterIO.append($('<option>', { value: io.name, text: io.name }));
                });
            });

            // FIR Statuses
            $.getJSON('/FIR/GetStatusOptions', function (data) {
                statusOptions = data;
                var $statusSelect = $('#newStatus');
                $statusSelect.empty();
                $.each(data, function (i, st) {
                    $statusSelect.append($('<option>', { value: st.value, text: st.label }));
                });

                var $filterStatus = $('#filterStatus');
                $filterStatus.empty().append('<option value="">All Statuses</option>');
                $.each(data, function (i, st) {
                    $filterStatus.append($('<option>', { value: st.value, text: st.label }));
                });
            });
        }

        loadDropdowns();

        // 2. Helper functions
        function fmtDate(iso) {
            if (!iso) return '';
            return new Date(iso + 'T00:00:00').toLocaleDateString('en-GB', {
                day: '2-digit', month: 'short', year: 'numeric'
            });
        }

        function badgeHtml(s) {
            var m = {
                'REGISTERED': 'badge-active',
                'UNDER_INVESTIGATION': 'badge-investigation',
                'CHALLAN_SUBMITTED': 'badge-pending',
                'IN_COURT': 'badge-pending',
                'CLOSED': 'badge-closed',
                'CANCELLED': 'badge-closed'
            };
            return '<span class="badge-pill ' + (m[s] || 'badge-closed') + '"><span class="dot"></span>' + s + '</span>';
        }

        function actHtml(firId) {
            return '<div class="actions">' +
                '<button class="act-btn view" title="View" data-id="' + firId + '"><i class="bi bi-eye"></i></button>' +
                '<button class="act-btn edit" title="Edit" data-id="' + firId + '"><i class="bi bi-pencil"></i></button>' +
                '<button class="act-btn del"  title="Delete" data-id="' + firId + '"><i class="bi bi-trash"></i></button>' +
                '</div>';
        }

        function toast(msg) {
            var el = document.getElementById('toast');
            document.getElementById('toastMsg').textContent = msg;
            el.classList.add('show');
            setTimeout(function () { el.classList.remove('show'); }, 3000);
        }

        // 3. DataTable with AJAX source
        try {
            var dt = $('#firTable').DataTable({
                ajax: {
                    url: '/FIR/GetFIRList',
                    dataSrc: function (json) {
                        $('#st-total').text(json.stats.total);
                        $('#st-closed').text(json.stats.closed);
                        $('#st-invest').text(json.stats.investigation);
                        $('#st-pending').text(json.stats.pending);
                        $('#sidebarCount').text(json.stats.total);
                        $('#recordCount').text(json.stats.total + ' case' + (json.stats.total !== 1 ? 's' : '') + ' registered');
                        return json.data;
                    }
                },
                pageLength: 10,
                order: [[1, 'desc']],
                autoWidth: false,
                dom: 't<"__dtfoot"ip>',
                columns: [
                    {
                        data: null, orderable: false,
                        render: function (d, t, r, meta) {
                            return '<span class="row-sno">' + String(meta.row + 1).padStart(2, '0') + '</span>';
                        }
                    },
                    {
                        data: 'firNo',
                        render: function (d) { return '<span class="fir-no" title="' + d + '">' + d + '</span>'; }
                    },
                    {
                        data: 'date',
                        render: function (d) { return '<span style="color:var(--ink-muted);font-size:.79rem">' + fmtDate(d) + '</span>'; }
                    },
                    {
                        data: 'desc', className: 'col-desc',
                        render: function (d, type) {
                            return type === 'display' ? '<span title="' + d.replace(/"/g, '&quot;') + '">' + d + '</span>' : d;
                        }
                    },
                    {
                        data: 'complainant',
                        render: function (d) { return '<span style="font-weight:600">' + d + '</span>'; }
                    },
                    {
                        data: 'accused',
                        render: function (d) { return '<span style="color:var(--ink-muted);font-size:.79rem">' + d + '</span>'; }
                    },
                    {
                        data: 'io',
                        render: function (d) { return '<span style="font-size:.8rem">' + d + '</span>'; }
                    },
                    {
                        data: 'status',
                        render: function (d) { return badgeHtml(d); }
                    },
                    {
                        data: 'firId', orderable: false,
                        render: function (d) { return actHtml(d); }
                    }
                ],
                drawCallback: function () {
                    var i = 1;
                    this.api().rows({ page: 'current' }).every(function () {
                        var sno = this.node().querySelector('.row-sno');
                        if (sno) sno.textContent = String(i++).padStart(2, '0');
                    });

                    var wrap = document.getElementById('firTable_wrapper');
                    var inner = wrap ? wrap.querySelector('.__dtfoot') : null;
                    if (inner) {
                        var infoEl = inner.querySelector('.dataTables_info');
                        var pagEl = inner.querySelector('.dataTables_paginate');
                        if (infoEl) document.getElementById('dtInfo').replaceWith(infoEl);
                        if (pagEl) document.getElementById('dtPaginate').replaceWith(pagEl);
                    }
                }
            });

            $('#customSearch').on('keyup', function () { dt.search(this.value).draw(); });
            $('#filterStatus').on('change', function () { dt.column(7).search(this.value).draw(); });
            $('#filterIO').on('change', function () { dt.column(6).search(this.value).draw(); });
        } catch (e) {
            console.error('DataTable init failed:', e);
            alert('Table initialisation error – check console.');
        }

        // 4. Action buttons (View, Edit, Delete)
        // View FIR details
        $('#firTable').on('click', '.act-btn.view', function () {
            var rowData = dt.row($(this).closest('tr')).data();
            if (!rowData) return;
            $('#viewBody').html(
                '<div class="detail-row"><div class="detail-label">FIR Number</div><div class="detail-value" style="font-weight:700;color:var(--teal-mid)">' + rowData.firNo + '</div></div>' +
                '<div class="detail-row"><div class="detail-label">Date</div><div class="detail-value">' + fmtDate(rowData.date) + '</div></div>' +
                '<div class="detail-row"><div class="detail-label">Description</div><div class="detail-value" style="white-space:normal;line-height:1.6">' + rowData.desc + '</div></div>' +
                '<div class="detail-row"><div class="detail-label">Complainant</div><div class="detail-value">' + rowData.complainant + '</div></div>' +
                '<div class="detail-row"><div class="detail-label">Accused</div><div class="detail-value">' + rowData.accused + '</div></div>' +
                '<div class="detail-row"><div class="detail-label">Investigating Officer</div><div class="detail-value">' + rowData.io + '</div></div>' +
                '<div class="detail-row"><div class="detail-label">Status</div><div class="detail-value">' + badgeHtml(rowData.status) + '</div></div>'
            );
            new bootstrap.Modal(document.getElementById('viewModal')).show();
        });

        // Edit FIR – populate the form and open the modal
        $('#firTable').on('click', '.act-btn.edit', function () {
            var rowData = dt.row($(this).closest('tr')).data();
            if (!rowData) return;

            $('#firIdHidden').val(rowData.firId);
            $('#newFirNo').val(rowData.firNo);
            $('#newDate').val(rowData.date);
            $('#newDesc').val(rowData.desc);
            $('#newComplainant').val(rowData.complainant);
            $('#newAccused').val(rowData.accused);

            var io = ioOptions.find(function (opt) { return opt.name === rowData.io; });
            if (io) $('#newIO').val(io.id);
            else $('#newIO').val('');

            $('#newStatus').val(rowData.status);

            $('#modalTitle').html('<i class="bi bi-pencil-square"></i> Edit FIR');
            new bootstrap.Modal(document.getElementById('registerModal')).show();
        });

        // Delete FIR – traditional POST via mini form
        $('#firTable').on('click', '.act-btn.del', function () {
            var id = $(this).data('id');
            var firNo = $(this).closest('tr').find('.fir-no').text();
            if (confirm('Delete ' + firNo + '?')) {
                var form = $('<form>', {
                    method: 'post',
                    action: '/FIR/Delete'
                }).append($('<input>', { type: 'hidden', name: 'id', value: id }));
                $('body').append(form);
                form.submit();
            }
        });

        // 5. Modal behaviour
        $('#registerModal').on('show.bs.modal', function () {
            if (!$('#firIdHidden').val()) {
                // New FIR – reset form
                $('#firForm')[0].reset();
                $('#newFirNo').val('Auto-generated on submit');
                $('#newDate').val(new Date().toISOString().slice(0, 10));
                $('#newStatus').val(statusOptions.length > 0 ? statusOptions[0].value : 'REGISTERED');
                $('#modalTitle').html('<i class="bi bi-file-earmark-plus"></i> Register New FIR <span class="fir-auto-badge"><i class="bi bi-lightning-fill"></i> Auto-numbered</span>');
            }
        });

        $('#registerModal').on('hidden.bs.modal', function () {
            // Clean up any lingering edit ID
            $('#firIdHidden').val('');
            $('#modalTitle').html('<i class="bi bi-file-earmark-plus"></i> Register New FIR <span class="fir-auto-badge"><i class="bi bi-lightning-fill"></i> Auto-numbered</span>');
        });

        // 6. Export CSV
        $('#exportBtn').on('click', function () {
            var data = dt.rows({ search: 'applied' }).data().toArray();
            var hdr = ['FIR No', 'Date', 'Description', 'Complainant', 'Accused', 'IO', 'Status'];
            var rows = data.map(function (r) {
                return [r.firNo, fmtDate(r.date), '"' + r.desc.replace(/"/g, '""') + '"', r.complainant, r.accused, r.io, r.status];
            });
            var csv = [hdr].concat(rows).map(function (r) { return r.join(','); }).join('\n');
            var a = document.createElement('a');
            a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv);
            a.download = 'FIR-Records-' + new Date().toISOString().slice(0, 10) + '.csv';
            a.click();
            toast('CSV exported.');
        });
    </script>
</body>
</html>-->