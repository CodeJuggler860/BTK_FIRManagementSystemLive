@{
    ViewData["Title"] = "Case & FIR Management";
    ViewData["PageTitle"] = "Case Summary";
    ViewData["PageSubtitle"] = "Bahria Town Karachi Security Department";
    ViewData["ActivePage"] = "Cases";
    ViewData["HideSidebar"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/Content/fir.css" />
}

@section TopbarActions {
    <button class="btn-outline-custom" data-bs-toggle="modal" data-bs-target="#addCaseModal">
        <i class="bi bi-folder-plus"></i> Add Case
    </button>
    @* "Add FIR" button removed – FIRs are now created from a case *@
}

<!-- CASE STATS (unchanged) -->
<div class="stats-grid">
    <div class="stat-card teal">
        <div class="stat-icon-wrap teal"><i class="bi bi-folder2-open"></i></div>
        <div class="stat-value" id="case-st-total">—</div>
        <div class="stat-label">Total Cases</div>
    </div>
    <div class="stat-card amber">
        <div class="stat-icon-wrap amber"><i class="bi bi-arrow-repeat"></i></div>
        <div class="stat-value" id="case-st-forwarded">—</div>
        <div class="stat-label">Forwarded to Police</div>
    </div>
    <div class="stat-card green">
        <div class="stat-icon-wrap green"><i class="bi bi-check-circle"></i></div>
        <div class="stat-value" id="case-st-closed">—</div>
        <div class="stat-label">Closed</div>
    </div>
    <div class="stat-card rose">
        <div class="stat-icon-wrap rose"><i class="bi bi-hourglass-split"></i></div>
        <div class="stat-value" id="case-st-open">—</div>
        <div class="stat-label">Open / Pending</div>
    </div>
</div>

<!-- CASE TABLE PANEL (unchanged) -->
<div class="panel" style="margin-bottom:30px;">
    <div class="panel-header">
        <div class="panel-title"><i class="bi bi-folder2-open"></i> Case Records</div>
        <span style="font-size:.76rem;color:var(--ink-faint)" id="caseRecordCount">Loading…</span>
    </div>
    <div class="filter-row">
        <div class="search-wrap">
            <i class="bi bi-search"></i>
            <input type="text" id="caseSearch" placeholder="Search by description, complainant, accused…">
        </div>
        <select class="filter-select" id="filterCaseStatus">
            <option value="">All Statuses</option>
            <option>OPEN</option>
            <option>CLOSED</option>
            <option>Forwarded to Police</option>
        </select>
    </div>
    <div class="tbl-wrap">
        <table id="caseTable" class="dataTable display" style="width:100%">
            <colgroup>
                <col style="width:50px">
                <col style="width:100px">
                <col style="width:auto">
                <col style="width:150px">
                <col style="width:150px">
                <col style="width:120px">
                <col style="width:100px">
                <col style="width:100px">
                <col style="width:100px">
            </colgroup>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Case ID</th>
                    <th>Description</th>
                    <th>Complainant</th>
                    <th>Accused</th>
                    <th>Status</th>
                    <th>FIR Registered</th>
                    <th>FIR</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <div class="tbl-footer">
        <div id="caseDtInfo"></div>
        <div id="caseDtPaginate"></div>
    </div>
</div>

@* ═══════════ FIR STATS (commented out) ═══════════
    <div class="stats-grid">
        <div class="stat-card teal">
            <div class="stat-icon-wrap teal"><i class="bi bi-files"></i></div>
