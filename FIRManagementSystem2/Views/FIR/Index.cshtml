@* ═══════════ FIR TABLE (commented out) ═══════════
    <div class="panel">
        <div class="panel-header">
            <div class="panel-title"><i class="bi bi-table"></i> FIR Records</div>
            <span style="font-size:.76rem;color:var(--ink-faint)" id="recordCount">Loading…</span>
        </div>
        <div class="filter-row">
            <div class="search-wrap">
                <i class="bi bi-search"></i>
                <input type="text" id="customSearch" placeholder="Search by FIR No, complainant, accused…">
            </div>
            <select class="filter-select" id="filterStatus">
                <option value="">All Statuses</option>
            </select>
            <select class="filter-select" id="filterIO">
