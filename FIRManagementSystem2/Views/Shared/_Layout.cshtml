<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Bahria Town Karachi Police</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- jQuery DataTables (CSS) -->
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

    <!-- Shared site styles (from /Content) -->
    <link rel="stylesheet" href="~/Content/site.css" />

    <!-- Page-specific styles injected here -->
    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- ══════════════════════════════════
         SIDEBAR — shared across all pages
         ══════════════════════════════════ -->
    @if (ViewData["HideSidebar"] == null || !(bool)ViewData["HideSidebar"])
    {
       <aside class="sidebar">
           <div class="sidebar-brand">
               <div class="shield-wrap">
                   <i class="bi bi-shield-fill-check"></i>
               </div>
               <h1>Bahria Town Karachi</h1>
               <p>Security Team</p>
           </div>

           <nav class="sidebar-nav">
               <div class="nav-label">Main</div>
               <a class="nav-item @(ViewData["ActivePage"]?.ToString() == "FIR" ? "active" : "")"
                  asp-controller="FIR" asp-action="Index">
                   <i class="bi bi-file-earmark-text"></i>
                   <span>FIR Management</span>
                   <span class="badge-nav" id="sidebarFirCount">—</span>
               </a>
               @*<a class="nav-item @(ViewData["ActivePage"]?.ToString() == "Personnel" ? "active" : "")"
                   asp-controller="Personnel" asp-action="Index">
                    <i class="bi bi-people"></i>
                    <span>Personnel</span>
                </a>
                <a class="nav-item @(ViewData["ActivePage"]?.ToString() == "Map" ? "active" : "")"
                   asp-controller="Map" asp-action="Index">
                    <i class="bi bi-geo-alt"></i>
                    <span>Jurisdiction Map</span>
                </a>

                <div class="nav-label">Reports</div>
                <a class="nav-item @(ViewData["ActivePage"]?.ToString() == "Analytics" ? "active" : "")"
                   asp-controller="Analytics" asp-action="Index">
                    <i class="bi bi-bar-chart-line"></i>
                    <span>Analytics</span>
                </a>
                <a class="nav-item" href="#">
                    <i class="bi bi-printer"></i>
                    <span>Print Reports</span>
                </a>
                <a class="nav-item" href="#">
                    <i class="bi bi-archive"></i>
                    <span>Archived FIRs</span>
                </a>

                <div class="nav-label">System</div>
                <a class="nav-item" href="#">
                    <i class="bi bi-sliders"></i>
                    <span>Settings</span>
                </a>
                <a class="nav-item" href="#">
                    <i class="bi bi-question-circle"></i>
                    <span>Help</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="avatar-sm">SHO</div>
                <div class="user-info">
                    <div class="name">SHO Abdul Rauf</div>
                    <div class="role">Station House Officer</div>
                </div>
            </div>*@
       </aside>
    }

    <!-- ══════════════════════════════════
         MAIN WRAPPER
         ══════════════════════════════════ -->
<main class="main-wrap @(ViewData["HideSidebar"] != null && (bool)ViewData["HideSidebar"] ? "main-full" : "")">

    <!-- TOP BAR -->
    <div class="topbar">
        <div class="topbar-left">
            <div class="eyebrow">
                <i class="bi bi-calendar3 me-1"></i>
                @DateTime.Now.ToString("dddd, dd MMMM yyyy")
            </div>
            <h2>@ViewData["PageTitle"]</h2>
            <p>@ViewData["PageSubtitle"]</p>
            @*<h2>@ViewData["PageDescription"]</h2>*@

        </div>
        <div class="topbar-actions d-flex gap-2 align-items-center flex-wrap">
            @RenderSection("TopbarActions", required: false)
        </div>
    </div>

    <!-- Page content -->
    @RenderBody()

</main>

    <!-- ══════════════════════════════════
         SHARED TOAST NOTIFICATION
         ══════════════════════════════════ -->
    <div class="toast-custom" id="globalToast">
        <i class="bi bi-check-circle-fill"></i>
        <span id="globalToastMsg">Done.</span>
    </div>

    <!-- ══════════════════════════════════
         SCRIPTS
         ══════════════════════════════════ -->
    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.0/dist/jquery.min.js"></script>
    <!-- jQuery DataTables -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <!-- Shared JS utilities -->
    <script>
        // ── Global toast helper (callable from any page script) ──
        function showToast(msg, isError) {
            const el = document.getElementById('globalToast');
            const ico = el.querySelector('i');
            document.getElementById('globalToastMsg').textContent = msg;
            ico.className = isError ? 'bi bi-exclamation-circle-fill' : 'bi bi-check-circle-fill';
            el.style.setProperty('--toast-icon-color', isError ? '#f87171' : '#5dca9a');
            el.classList.add('show');
            setTimeout(() => el.classList.remove('show'), 3200);
        }

        // ── Mark active nav item from server-set ViewData ──
        // (handled inline via Razor above — nothing extra needed)
    </script>

    <!-- Page-specific scripts injected here -->
    @RenderSection("Scripts", required: false)

</body>
</html>
